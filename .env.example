# ---------------------------------------------------------------------------
# Glowing Space BD — production environment (single VPS, Docker Compose)
# Generate a real one with:  ./deploy/make-env.sh
# Never commit .env — it holds secrets.
# ---------------------------------------------------------------------------

# --- Site -----------------------------------------------------------------
DOMAIN="glowingspacebd.com"
TLS_EMAIL="owner@glowingspacebd.com"
SITE_URL="https://glowingspacebd.com"
BUILD_ID="prod"

# --- Database (used by both the db and app containers) --------------------
POSTGRES_USER="gsbd"
POSTGRES_PASSWORD="change-me-to-something-long-and-random"
POSTGRES_DB="gsbd"

# --- Application ----------------------------------------------------------
# 48+ random characters. Invalidates all admin sessions when rotated.
SESSION_SECRET="change-me-to-at-least-32-random-characters"
# Bearer token for the maintenance cron (outbox flush, cart reminders, expiry).
CRON_SECRET="change-me-to-something-random"
